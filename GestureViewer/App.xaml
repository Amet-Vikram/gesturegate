<Application x:Class="GestureViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Palette -->
        <SolidColorBrush x:Key="PageBrush"      Color="#F4F6F8"/>
        <SolidColorBrush x:Key="CardBrush"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush2"   Color="#DDE1E6"/>
        <SolidColorBrush x:Key="TextBrush"      Color="#1B1F24"/>
        <SolidColorBrush x:Key="MutedBrush"     Color="#68727D"/>
        <SolidColorBrush x:Key="LockedBrush"    Color="#4B5563"/>
        <SolidColorBrush x:Key="StaticBrush"    Color="#1D4ED8"/>
        <SolidColorBrush x:Key="DynamicBrush"   Color="#B45309"/>
        <SolidColorBrush x:Key="OkBrush"        Color="#15803D"/>
        <SolidColorBrush x:Key="WarnBrush"      Color="#B45309"/>
        <SolidColorBrush x:Key="ErrorBrush"     Color="#B91C1C"/>

        <!-- Text -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Card container -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Controls -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Application.Resources>
</Application>
