<Window x:Class="GestureViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gesture Viewer" Height="720" Width="960" MinHeight="560" MinWidth="780"
        Background="{StaticResource PageBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="2,0,2,12">
            <Border DockPanel.Dock="Right" x:Name="StatusPill"
                    Background="{StaticResource MutedBrush}" CornerRadius="10" Padding="10,4"
                    VerticalAlignment="Center">
                <TextBlock x:Name="StatusPillText" Text="Disconnected"
                           Foreground="White" FontSize="12" FontFamily="Segoe UI Semibold"/>
            </Border>
            <StackPanel>
                <TextBlock Text="Gesture Viewer" Style="{StaticResource TitleText}"/>
                <TextBlock x:Name="RelayUrlText" Style="{StaticResource LabelText}" Text="—" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Connection -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Edge device" Style="{StaticResource LabelText}" Margin="0,0,10,0"/>

                <ComboBox Grid.Column="1" x:Name="DeviceCombo" Margin="0,0,10,0"/>

                <Button Grid.Column="2" x:Name="RefreshButton" Content="Refresh devices" Click="RefreshButton_Click"/>

                <Button Grid.Column="3" x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click"
                        Margin="0" IsDefault="True"/>
            </Grid>
        </Border>

        <!-- State banner -->
        <Border Grid.Row="2" x:Name="StateBanner" Background="{StaticResource LockedBrush}"
                CornerRadius="6" Padding="18,16" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="StateSinceText" Text=""
                           Foreground="#DCE3EA" FontSize="12" VerticalAlignment="Bottom"/>
                <StackPanel>
                    <TextBlock x:Name="StateText" Text="LOCKED" Foreground="White"
                               FontFamily="Segoe UI Semibold" FontSize="34"/>
                    <TextBlock x:Name="StateDetailText" Text="Not connected to a relay."
                               Foreground="#E4EAF0" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Gestures -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,2,10">
                    <Button DockPanel.Dock="Right" x:Name="ClearButton" Content="Clear"
                            Click="ClearButton_Click" Margin="0" MinWidth="72"/>
                    <TextBlock x:Name="GestureCountText" Style="{StaticResource LabelText}"
                               Text="No gestures received yet" VerticalAlignment="Center"/>
                </DockPanel>

                <Grid>
                    <ListView x:Name="GestureList" BorderThickness="0" FontFamily="Segoe UI"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                        <Setter Property="FontStyle" Value="Italic"/>
                                        <Setter Property="Opacity" Value="0.55"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Time" Width="80" DisplayMemberBinding="{Binding Time}"/>
                                <GridViewColumn Header="Gesture sequence" Width="230" DisplayMemberBinding="{Binding Sequence}"/>
                                <GridViewColumn Header="Confidence" Width="150" DisplayMemberBinding="{Binding Confidence}"/>
                                <GridViewColumn Header="Gate at arrival" Width="130" DisplayMemberBinding="{Binding Gate}"/>
                                <GridViewColumn Header="Vocabulary" Width="140" DisplayMemberBinding="{Binding Vocab}"/>
                                <GridViewColumn Header="Device" Width="110" DisplayMemberBinding="{Binding Device}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock x:Name="EmptyStateText" Style="{StaticResource LabelText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Connect to a device, then perform gestures at the camera."/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Activity log -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12,8">
            <Expander x:Name="LogExpander" IsExpanded="True" FontFamily="Segoe UI">
                <Expander.Header>
                    <TextBlock Text="Activity log" FontFamily="Segoe UI Semibold" FontSize="13"/>
                </Expander.Header>
                <ListBox x:Name="LogList" Height="150" Margin="0,8,0,0" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </Expander>
        </Border>

    </Grid>
</Window>
